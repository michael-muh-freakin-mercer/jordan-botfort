{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__alpaca",
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(python3:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "mcp__robinhood-trading",
      "mcp__Mercury",
      "mcp__mercury",
      "mcp__Gmail",
      "mcp__gmail",
      "mcp__Google_Calendar",
      "mcp__Google_Docs",
      "mcp__Google_Drive",
      "mcp__Google_Sheets",
      "mcp__Notion",
      "mcp__notion",
      "mcp__Claude_Docs",
      "mcp__github",
      "mcp__stripe",
      "mcp__Stripe",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position",
      "mcp__alpaca__create_locate",
      "mcp__alpaca__update_account_config",
      "mcp__alpaca__close_position",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__delete_watchlist_by_id",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(crontab:*)",
      "Bash(systemctl:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Read(~/.claude/**)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./state/authorization.json)",
      "Edit(./state/authorization.json)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)",
      "Write(./config/**)",
      "Edit(./config/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./scripts/**)",
      "Edit(./scripts/**)",
      "Write(./prompts/**)",
      "Edit(./prompts/**)",
      "Write(./.mcp.json)",
      "Edit(./.mcp.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__alpaca__place_.*|mcp__alpaca__close_.*|mcp__alpaca__replace_.*|mcp__alpaca__cancel_all_orders|mcp__alpaca__exercise_.*|mcp__alpaca__do_not_exercise_.*|mcp__alpaca__create_locate|mcp__alpaca__update_account_config",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/order-guard.py",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {}
}
